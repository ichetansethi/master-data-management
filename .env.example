# Database connection settings — Leads DB
DB_HOST="localhost"
DB_PORT="5434"
DB_USER="your_leads_db_user"
DB_PASS="your_leads_db_password"
DB_NAME="leads_db"

LEADS_DB_URL="postgresql+asyncpg://${DB_USER}:${DB_PASS}@${DB_HOST}:${DB_PORT}/${DB_NAME}"

# Database connection settings — App/Config DB
APP_CONFIG_DB_HOST="localhost"
APP_CONFIG_DB_PORT="5435"
APP_CONFIG_DB_USER="your_app_db_user"
APP_CONFIG_DB_PASS="your_app_db_password"
APP_CONFIG_DB_NAME="app_db_config"

APP_CONFIG_DB_URL="postgresql+asyncpg://${APP_CONFIG_DB_USER}:${APP_CONFIG_DB_PASS}@${APP_CONFIG_DB_HOST}:${APP_CONFIG_DB_PORT}/${APP_CONFIG_DB_NAME}"

JWT_SECRET_KEY="your-secret-key-here"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES="30"

# Object storage (S3-compatible) — Cloudflare R2
S3_ENDPOINT_URL="https://<account_id>.r2.cloudflarestorage.com"

# Test connector S3 fixture — used only by scripts/seed_test_connector.py,
# never read by the app itself. Each real connector's bucket/credentials
# live in its own connection_config row, not here.
TEST_CONNECTOR_S3_BUCKET="your-test-bucket"
TEST_CONNECTOR_S3_PREFIX=""
TEST_CONNECTOR_S3_ACCESS_KEY_ID="your_r2_access_key_id"
TEST_CONNECTOR_S3_SECRET_ACCESS_KEY="your_r2_secret_access_key"
